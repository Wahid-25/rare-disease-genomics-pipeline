{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/genosphere-clinical-report-v1.json",
  "title": "Genosphere Clinical Report Data",
  "description": "Data contract between the genomic pipeline and the interactive clinical-style report builder.",
  "type": "object",
  "required": [
    "schema_version",
    "report_status",
    "patient",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed_draft",
        "final"
      ]
    },
    "laboratory": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "signatory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "patient": {
      "type": "object",
      "required": [
        "case_id"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "patient_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "sex": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_of_birth": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "indication": {
          "type": [
            "string",
            "null"
          ]
        },
        "ordering_physician": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "specimen": {
          "type": [
            "string",
            "null"
          ]
        },
        "reported_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "collected_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "received_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": true
    },
    "test": {
      "type": "object",
      "properties": {
        "report_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "genome_build": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysis_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "pipeline_status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "finding_type",
          "gene"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "finding_type": {
            "type": "string",
            "enum": [
              "small_variant",
              "copy_number_variant",
              "repeat_expansion",
              "pharmacogenomic",
              "other"
            ]
          },
          "gene": {
            "type": [
              "string",
              "null"
            ]
          },
          "transcript": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "coordinate": {
            "type": "object",
            "properties": {
              "genome_build": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chromosome": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "position": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "alternate": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "display": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "hgvs": {
            "type": "object",
            "properties": {
              "coding": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "protein": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "zygosity": {
            "type": [
              "string",
              "null"
            ]
          },
          "inheritance": {
            "type": [
              "string",
              "null"
            ]
          },
          "classification": {
            "type": "object",
            "properties": {
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "review_status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "analyst_reviewed": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          },
          "confirmation": {
            "type": "object",
            "properties": {
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "statement": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "clinpgx": {
            "type": "object",
            "properties": {
              "summary": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "narrative": {
      "type": "object",
      "properties": {
        "patient_phenotype": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant_information": {
          "type": [
            "string",
            "null"
          ]
        },
        "gene_information": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "references": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "citation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
